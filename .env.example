# Local development only. Never place production credentials here.

# PostgreSQL
POSTGRES_DB=smart_expense
POSTGRES_USER=smart_expense
POSTGRES_PASSWORD=dev-only-postgres-password

# RabbitMQ
RABBITMQ_DEFAULT_USER=dev-rabbit
RABBITMQ_DEFAULT_PASS=dev-only-rabbit-password

# Keycloak development administrator and imported test user
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password

# Browser-facing frontend configuration
VITE_API_BASE_URL=/
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_KEYCLOAK_REALM=budget-portal
VITE_KEYCLOAK_CLIENT_ID=budget-portal-client

# Optional external secret. Leave blank for the base Gemini-independent stack.
GEMINI_API_KEY=
